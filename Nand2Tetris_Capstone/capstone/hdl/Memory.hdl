// Memory chip: RAM16K (0x0000-0x3FFF), Screen (0x4000-0x5FFF), Keyboard (0x6000)
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Route load signal (RAM: address[14]=0, Screen: address[14]=1 and address[13]=0)
    DMux(in=load, sel=address[14], a=loadRAM, b=loadIO);
    DMux(in=loadIO, sel=address[13], a=loadScreen, b=loadKBD);

    // Storage and I/O chips
    RAM16K(in=in, load=loadRAM, address=address[0..13], out=outRAM);
    Screen(in=in, load=loadScreen, address=address[0..12], out=outScreen);
    Keyboard(out=outKBD);

    // Output multiplexer
    Mux16(a=outScreen, b=outKBD, sel=address[13], out=outIO);
    Mux16(a=outRAM, b=outIO, sel=address[14], out=out);
}
